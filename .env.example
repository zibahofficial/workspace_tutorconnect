# ---------------------------------------------------------------------------
# TutorConnect — environment template
#
#   cp .env.example .env      then edit the values below.
#
# NEVER commit the real .env file. Every value here is a placeholder — the
# repository ships no passwords, no JWT secret and no database credentials.
# Anything left unset falls back to a safe development default in
# backend/config.py.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=TutorConnect
APP_TAGLINE=Find the right tutor. Learn with confidence.
# development | staging | production
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# Default (zero-config) — a SQLite file inside ./data
DATABASE_URL=sqlite:///./data/tutorconnect.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg2://tutorconnect:CHANGE_ME@localhost:5432/tutorconnect

# Log every SQL statement (noisy — development only)
DB_ECHO=false

# --- Security --------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty the app boots with a random per-process secret and warns you:
# tokens then stop working on every restart, which is safe but inconvenient.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Allow any origin (development convenience — never enable in production)
CORS_ALLOW_ALL=true

# --- Seed / first administrator -------------------------------------------
# On first boot the app creates the subject vocabulary, this admin account and
# (when SEED_DEMO_DATA=true) a demo dataset of tutors, students, availability,
# bookings and reviews. Re-running is a no-op, so it is safe to restart often.
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeBeforeDeploying123
ADMIN_NAME=Platform Administrator

# --- Business rules --------------------------------------------------------
# How far ahead a student must book (hours).
MIN_BOOKING_LEAD_HOURS=2
# Listing page sizes.
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100
# Currency used across the UI and API.
CURRENCY=NGN
CURRENCY_SYMBOL=₦
